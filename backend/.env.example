# Environment variables for the backend

# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173,http://localhost:3000
# Production: replace with your Vercel frontend URL (e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Temporary directory for file uploads (defaults to system temp)
# TEMP_DIR=/tmp/doc-converter
